# Server Port
PORT=3001

# Database Configuration (PostgreSQL / Supabase / Neon)
# If left blank, backend automatically falls back to an embedded SQLite database (launchpad.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robinhood_launchpad

# Robinhood Chain Testnet RPC
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630

# Smart Contract Addresses on Robinhood Chain Testnet
FACTORY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
UNISWAP_V4_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Auto-Pin Coin Logos to Decentralized IPFS via Pinata (Free at https://app.pinata.cloud)
# If provided, all newly uploaded coin logos will be permanently pinned to IPFS!
PINATA_JWT=

