# ==============================================================
# ROBINHOOD CHAIN LAUNCHPAD - ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Port (Auto-assigned by cloud hosts like Render / Railway / Heroku)
PORT=3001

# --------------------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------------------
# Option 1: Free Cloud PostgreSQL (RECOMMENDED FOR CLOUD HOSTING)
# Free instant database providers (data will never be lost on restart):
# - Neon: https://neon.tech (Copy connection string)
# - Supabase: https://supabase.com
# Example:
# DATABASE_URL=postgresql://user:password@ep-cool-base-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local SQLite (Zero setup, for local testing)
# Leave DATABASE_URL blank to automatically use local SQLite (backend/launchpad.db)
DATABASE_URL=

# --------------------------------------------------------------
# ROBINHOOD CHAIN L2 RPC (Arbitrum Orbit)
# --------------------------------------------------------------
# Chain ID: 46630 | Gas: Native ETH
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ROUTER_V4_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Alchemy RPC Backup
# ALCHEMY_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_API_KEY
